{% extends "shell.html.j2" %}

{% block body %}
<section class="playground-page">
  <div class="pg-input">
    <label class="field">SQL
      <textarea id="sql" name="sql" autocomplete="off" spellcheck="false" placeholder="例如 INSERT OVERWRITE TABLE dst SELECT id FROM src…"></textarea>
    </label>
    <button id="parse" type="button">解析 SQL</button>
    <div id="msg" class="help-text" role="status" aria-live="polite"></div>
  </div>
  <div id="cy" role="application" aria-label="SQL 解析结果图">
    <div class="graph-empty">输入 SQL 后点击解析，查看表、字段和转换关系。</div>
  </div>
  <aside id="detail" class="detail" aria-live="polite"></aside>
</section>
{% endblock %}

{% block page_script %}
<script>
document.getElementById('parse').addEventListener('click', async () => {
  const sql = document.getElementById('sql').value.trim();
  const msg = document.getElementById('msg');
  if(!sql){ msg.textContent='请输入 SQL'; return; }
  msg.textContent='解析中…';
  const res = await fetch('/api/parse', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({sql, dialect:'spark'})
  });
  const data = await res.json();
  if(!data.ok){ msg.textContent = data.error || '解析失败，请检查 SQL 语法。'; return; }
  msg.textContent = `节点 ${data.elementCount.nodes} · 边 ${data.elementCount.edges}`;
  window.renderGraph({elements: data.elements});
});
window.onGraphNodeTap = (nodeId) => {};
</script>
{% endblock %}
